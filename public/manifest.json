{
  "manifest_version": 3,
  "name": "Breathe Focus",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "A little space for what matters. Gentle focus sessions, quiet breaks, and a clear mind.",
  "permissions": ["storage", "alarms", "notifications", "offscreen"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Breathe Focus",
    "default_popup": "index.html",
    "default_icon": { "16": "images/flower-icons-for-free16.png", "32": "images/flower-icons-for-free32.png", "48": "images/flower-icons-for-free48.png", "128": "images/flower-icons-for-free128.png" }
  },
  "icons": { "16": "images/flower-icons-for-free16.png", "32": "images/flower-icons-for-free32.png", "48": "images/flower-icons-for-free48.png", "128": "images/flower-icons-for-free128.png" },
  "options_page": "index.html",
  "commands": { "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+J" }, "description": "Open Breathe Focus" } },
  "content_security_policy": { "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; media-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" }
}
